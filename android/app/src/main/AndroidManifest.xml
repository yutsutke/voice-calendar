<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- v64 の Android 版: ホーム画面の長押し（App Shortcut）で「リスト」を開く（res/xml/shortcuts.xml） -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions（iOS の Info.plist 権限に対応する Android 側） -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 音声入力（SpeechRecognizer）。転写はシステムの音声認識サービスが行う -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- カレンダー保存（CalendarContract 直書き）。Android には iOS17 の「書き込み専用」に当たる権限が
         無いため READ+WRITE を要求する（READ は書き込み先カレンダーの解決だけに使う＝既存予定は読まない） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- v69: 保存した予定が Google まで上がるかは **アカウントの同期設定** が決める（カレンダー権限とは別物）。
         これが読めないと「端末には在るのにサーバに無い」を実機の画面から説明できない（実機FB第38回で実際に詰まった）。
         normal permission ＝インストール時に付与・ダイアログは出ない・**設定を変更する権限ではない**（読むだけ）。 -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />

    <!-- v72: 位置情報（詳細設定「保存時に位置情報も記録する」＝**既定オフ**・端末の外に出さない）。
         🔑 **Android は位置プラグインを作らない**＝ Capacitor の BridgeWebChromeClient が
         onGeolocationPermissionsShowPrompt で **位置要求のたびに** OS の権限状態を読み直し
         （PermissionHelper.hasPermissions）、無ければランタイムダイアログを出す実装を持っている
         ＝ web 経路の navigator.geolocation がそのまま通る（node_modules のソースで確認）。
         ※ iOS で native プラグイン（CLLocationManager）が要ったのは、WKWebView が許可状態を
           プロセス内に握って OS の変更を見ない病気があったから（v52・実機FB第33回）。
           Android は要求のたびに読み直す構造なので同じ病気は起きない**見込み**（実機で確認する）。
         COARSE も宣言するのは Android 12+ が「おおよその位置」だけを許可できるため
         （精度は落ちるが取れる＝取れないより良い。用途は「保存した時にいた場所」）。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android 11+ のパッケージ可視性: これが無いと SpeechRecognizer.isRecognitionAvailable が
         音声認識サービスを見つけられず false を返す（黙って「利用できません」になる罠） -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
